<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio Voice Check"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record a voice sample or upload an audio file to check if it is real human speech or an AI clone."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Large 72dp Record Button for Non-Technical Users -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_record"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@color/button_record_bg"
            app:tint="#FFFFFF"
            app:fabCustomSize="72dp"
            app:srcCompat="@drawable/ic_mic" />

        <TextView
            android:id="@+id/tv_record_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to Record Voice"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Upload Audio File Button (Min 48dp) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_upload_audio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Upload Audio File"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_result"
            app:iconPadding="10dp"
            app:backgroundTint="@color/surface_card"
            android:textColor="@color/text_primary" />

    </LinearLayout>
</ScrollView>
