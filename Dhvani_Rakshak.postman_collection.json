            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scenario\": \"elevenlabs_clone\",\n  \"caller_number\": \"+91 98200 12345\",\n  \"carrier\": \"Airtel\",\n  \"codec\": \"PCMU\",\n  \"target_speaker\": \"VIP_CEO_RAJESH\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/telecom/simulate-call",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "telecom", "simulate-call"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ]
